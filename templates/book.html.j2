<!DOCTYPE html>
<html lang="{{ meta.idioma }}">
<head>
  <meta charset="utf-8">
  <title>{{ meta.titulo }} — {{ meta.subtitulo }}</title>
  <style>{{ inline_css }}</style>
</head>
<body>

{# ----------------------------- PORTADA ----------------------------- #}
<section class="cover cover--plain">
  {% if cover_src %}<img class="cover-bg" src="{{ cover_src }}" alt=""><div class="cover-scrim"></div>{% endif %}
  <div class="cover-inner">
    <div class="cover-kicker">{{ ui.kicker }}</div>
    <h1 class="cover-title" id="portada-titulo">{{ meta.titulo }}</h1>
    <p class="cover-sub">{{ meta.subtitulo }}</p>
    <div class="cover-rule"></div>
    {% if meta.autor %}<p class="cover-author">{{ meta.autor }}</p>{% endif %}
  </div>
</section>

{# --------------------------- PÁG. TÍTULO --------------------------- #}
<section class="page title-page">
  <h1 id="titulo-libro">{{ meta.titulo }}</h1>
  <p class="title-sub">{{ meta.subtitulo }}</p>
  {% if meta.autor %}<p class="title-author">{{ meta.autor }}</p>{% endif %}
</section>

{# ----------------------------- CRÉDITOS --------------------------- #}
<section class="page credits">
  <p><strong>{{ meta.titulo }}</strong> — {{ meta.subtitulo }}</p>
  <p>© {{ meta.anio }}{% if meta.autor %} {{ meta.autor }}.{% else %}.{% endif %} {{ ui.rights }}</p>
  {% if meta.isbn %}<p>ISBN: {{ meta.isbn }}</p>{% endif %}
  <p>{{ meta.editorial }}</p>
  <p class="credits-note">{{ ui.credits_note }}</p>
  <p class="credits-note">{{ ui.ai_note }}</p>
</section>

{# ------------------------------ ÍNDICE ----------------------------- #}
<section class="page toc">
  <h2 class="section-h">{{ ui.toc }}</h2>
  <ul class="toc-front-list">
    <li>{{ textos.intro_titulo }}</li>
    <li>{{ textos.como_usar.titulo }}</li>
    <li>{{ textos.seguridad.titulo }}</li>
    <li>{{ ui.legend }}</li>
  </ul>
  {% for e in edades %}
  <div class="toc-chapter-block">
    <h3 class="toc-ch-h">{{ e.titulo }} <span class="toc-ch-lema">· {{ e.lema }}</span></h3>
    <ul class="toc-cols">
      {% for a in actividades if a.edad == e.rango %}
      <li style="--tc:{{ tipos[a.tipo].color }}"><a href="#act-{{ a.id }}"><span class="mini-dot"></span><span class="toc-t">{{ a.titulo }}</span></a></li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
  <p class="toc-legend">
    {% for key, t in tipos.items() %}<span class="legend-item"><span class="mini-dot" style="--tc:{{ t.color }}"></span> {{ t.label }}</span> {% endfor %}
  </p>
</section>

{# --------------------------- INTRODUCCIÓN -------------------------- #}
<section class="page prose">
  <h2 class="section-h">{{ textos.intro_titulo }}</h2>
  {% for p in textos.introduccion.split('\n') if p.strip() %}
    <p>{{ p.strip() }}</p>
  {% endfor %}
</section>

{# --------------------------- CÓMO USAR ----------------------------- #}
<section class="page prose">
  <h2 class="section-h">{{ textos.como_usar.titulo }}</h2>
  <ol class="howto">
    {% for p in textos.como_usar.puntos %}<li>{{ p }}</li>{% endfor %}
  </ol>
</section>

{# --------------------------- SEGURIDAD ----------------------------- #}
<section class="page prose safety">
  <h2 class="section-h">{{ textos.seguridad.titulo }}</h2>
  <p>{{ textos.seguridad.intro }}</p>
  <ul class="safety-list">
    {% for p in textos.seguridad.puntos %}<li>{{ p }}</li>{% endfor %}
  </ul>
  <p class="disclaimer">{{ textos.seguridad.descargo }}</p>
</section>

{# --------------------------- LEYENDA ------------------------------- #}
<section class="page legend">
  <h2 class="section-h">{{ ui.legend }}</h2>
  <p class="legend-lead">{{ ui.legend_lead }}</p>

  <div class="legend-block">
    <h3>{{ leyenda.preparacion.titulo }}</h3>
    {% for n in range(3) %}
      <div class="legend-row">
        <span class="dots">{% for i in range(3) %}<span class="dot {{ 'on' if i <= n }}"></span>{% endfor %}</span>
        <span class="legend-text">{{ leyenda.preparacion.niveles[n] }}</span>
      </div>
    {% endfor %}
  </div>

  <div class="legend-block">
    <h3>{{ leyenda.materiales.titulo }}</h3>
    {% for n in range(3) %}
      <div class="legend-row">
        <span class="squares">{% for i in range(3) %}<span class="sq {{ 'on' if i <= n }}"></span>{% endfor %}</span>
        <span class="legend-text">{{ leyenda.materiales.niveles[n] }}</span>
      </div>
    {% endfor %}
  </div>

  <div class="legend-block">
    <h3>{{ leyenda.duracion.titulo }}</h3>
    <div class="legend-row">
      <span class="ico-clock">{{ icons.reloj }}</span>
      <span class="legend-text">{{ leyenda.duracion.texto }}</span>
    </div>
  </div>

  <div class="legend-block">
    <h3>{{ ui.types }}</h3>
    <div class="legend-types">
      {% for key, t in tipos.items() %}
        <span class="type-chip" style="--c:{{ t.color }}">
          <span class="type-ico" style="color:{{ t.color }}">{{ icons[t.icon] }}</span>{{ t.label }}
        </span>
      {% endfor %}
    </div>
  </div>
</section>

{# --------------------------- CAPÍTULOS ----------------------------- #}
{% for e in edades %}
  <section class="page chapter-divider {{ 'divider--image' if e.cover_src else 'divider--plain' }}"
           style="--accent:{{ palette.verde }}">
    {% if e.cover_src %}<img class="divider-img" src="{{ e.cover_src }}" alt="">{% endif %}
    <div class="divider-inner">
      <div class="divider-age">{{ e.titulo }}</div>
      <div class="divider-lema">{{ e.lema }}</div>
    </div>
  </section>

  {% set band_acts = actividades | selectattr('edad','equalto',e.rango) | list %}
  {% set n_exp = band_acts | selectattr('tipo','equalto','experimento') | list | length %}
  {% set n_facil = band_acts | selectattr('dif_prep','equalto',1) | list | length %}
  <section class="page prose chapter-intro">
    <h2 class="section-h">{{ e.titulo }}</h2>
    <p class="chapter-lema">{{ e.lema }}</p>
    <p>{{ e.intro }}</p>
    <div class="chapter-stats">
      <div class="stat"><div class="stat-num">{{ band_acts|length }}</div><div class="stat-label">{{ ui.stat_acts }}</div></div>
      <div class="stat"><div class="stat-num">{{ n_exp }}</div><div class="stat-label">{{ ui.stat_exp }}</div></div>
      <div class="stat"><div class="stat-num">{{ n_facil }}</div><div class="stat-label">{{ ui.stat_easy }}</div></div>
    </div>
    <h3 class="minitoc-h">{{ ui.in_chapter }}</h3>
    <ul class="chapter-minitoc">
      {% for a in band_acts %}
      <li style="--tc:{{ tipos[a.tipo].color }}"><span class="mini-dot"></span><span class="mini-title">{{ a.titulo }}</span><span class="mini-dur">{{ a.duracion }}</span></li>
      {% endfor %}
    </ul>
  </section>

  {% for a in actividades if a.edad == e.rango %}
    {% set t = tipos[a.tipo] %}
    <article class="page activity" id="act-{{ a.id }}" style="--c:{{ t.color }}">
      <header class="act-head">
        <span class="act-type"><span class="act-type-ico" style="color:{{ t.color }}">{{ icons[t.icon] }}</span>{{ t.label }}</span>
        <span class="act-age">{{ e.titulo }}</span>
      </header>
      <h2 class="act-title">{{ a.titulo }}</h2>
      {% if a.gancho %}<p class="act-hook">{{ a.gancho }}</p>{% endif %}

      <div class="act-badges">
        <div class="badge">
          <span class="badge-label">{{ ui.badge_prep }}</span>
          <span class="dots">{% for i in range(3) %}<span class="dot {{ 'on' if i < a.dif_prep }}"></span>{% endfor %}</span>
        </div>
        <div class="badge">
          <span class="badge-label">{{ ui.badge_mat }}</span>
          <span class="squares">{% for i in range(3) %}<span class="sq {{ 'on' if i < a.dif_materiales }}"></span>{% endfor %}</span>
        </div>
        <div class="badge badge-time">
          <span class="ico-clock">{{ icons.reloj }}</span>
          <span class="badge-time-val">{{ a.duracion }}</span>
        </div>
      </div>

      {% if a.imagen_src %}<img class="act-img" src="{{ a.imagen_src }}" alt="{{ a.titulo }}">{% endif %}

      <div class="act-cols">
        <div class="act-left">
          <h3 class="act-h3">{{ ui.materials }}</h3>
          <ul class="act-materials">{% for m in a.materiales %}<li>{{ m }}</li>{% endfor %}</ul>
          {% if a.preparacion %}
            <h3 class="act-h3">{{ ui.prep }}</h3>
            <p class="act-prep">{{ a.preparacion }}</p>
          {% endif %}
        </div>
        <div class="act-right">
          <h3 class="act-h3">{{ ui.steps }}</h3>
          <ol class="act-steps">{% for s in a.pasos %}<li>{{ s }}</li>{% endfor %}</ol>
        </div>
      </div>

      <div class="act-notes-row">
        {% if a.aprendizaje %}
          <div class="act-note act-learn"><strong>{{ ui.learn }}</strong> {{ a.aprendizaje }}</div>
        {% endif %}
        {% if a.variantes %}
          <div class="act-note act-variant"><strong>{{ ui.variants }}</strong> {{ a.variantes }}</div>
        {% endif %}
      </div>
      {% if a.seguridad %}
        <div class="act-note act-safety"><strong>{{ ui.safety }}</strong> {{ a.seguridad }}</div>
      {% endif %}

      {% set log_q = ui.log_q_baby if a.edad == "0-2" else ui.log_q %}
      <div class="act-log">
        <div class="log-head">
          <span class="log-check"></span><span class="log-title">{{ ui.log_title }}</span>
          <span class="log-date">{{ ui.log_date }} <span class="write-slot"></span></span>
          <span class="log-stars">☆☆☆☆☆</span>
        </div>
        <p class="log-q">{{ log_q }}</p>
        <div class="write-line"></div><div class="write-line"></div><div class="write-line"></div>
        <p class="log-q draw-q">{{ ui.draw_q_baby if a.edad == "0-2" else ui.draw_q }}</p>
        <div class="draw-box"></div>
      </div>
      <div class="act-end"></div>
    </article>
  {% endfor %}
{% endfor %}

{# ------------------------------ ÍNDICE POR TIPO -------------------- #}
<section class="page prose">
  <h2 class="section-h">{{ ui.bytype }}</h2>
  {% for key, t in tipos.items() %}
    {% set group = actividades | selectattr('tipo','equalto',key) | list %}
    {% if group %}
      <h3 class="bytype-h" style="color:{{ t.color }}">{{ t.label }}</h3>
      <ul class="bytype-list bytype-cols">
        {% for a in group %}<li>{{ a.titulo }} <span class="bytype-age">({{ a.edad }} {{ ui.years }})</span></li>{% endfor %}
      </ul>
    {% endif %}
  {% endfor %}
</section>

{# ------------------------------ CIERRE ----------------------------- #}
<section class="page prose closing">
  <h2 class="section-h">{{ textos.cierre.titulo }}</h2>
  <p>{{ textos.cierre.texto }}</p>
  {% if meta.autor %}<p class="closing-sign">— {{ meta.autor }}</p>{% endif %}
</section>

</body>
</html>
